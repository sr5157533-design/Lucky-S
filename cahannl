<!doctype html>
<html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Lucky-S | Channel</title><meta name="description" content="Lucky-S par apna video aur photo channel banayein."><meta name="robots" content="index,follow">
<style>
*{box-sizing:border-box}body{margin:0;background:#f4f7ff;color:#17233b;font:16px Arial,sans-serif}header{background:#fff;padding:15px 5%;display:flex;gap:14px;align-items:center;justify-content:space-between;border-bottom:1px solid #dfe7f4;position:sticky;top:0}.brand{font-size:24px;font-weight:bold;color:#155eef}button{border:0;border-radius:10px;padding:12px 16px;background:#155eef;color:white;font-weight:bold;cursor:pointer}input,textarea,select{width:100%;padding:12px;border:1px solid #ccd8ea;border-radius:9px;margin:6px 0 14px;font:inherit}main{max-width:1000px;margin:24px auto;padding:0 16px}.hero,.box,.channel,.post{background:white;border:1px solid #dfe7f4;border-radius:18px;padding:22px;margin-bottom:18px}.hero{background:linear-gradient(120deg,#e2edff,#fff)}h1{font-size:clamp(28px,5vw,42px);margin:0 0 10px}h2{margin:0 0 8px}.muted{color:#65738b}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}.channel{display:flex;gap:13px;align-items:center}.avatar{width:55px;height:55px;border-radius:50%;background:#eaf1ff;display:grid;place-items:center;color:#155eef;font-size:25px;flex-shrink:0}.channel div:nth-child(2){flex:1}.post img,.post video{width:100%;max-height:260px;object-fit:contain;background:#eaf1ff;border-radius:10px}.notice{background:#fff7df;border:1px solid #f0dda0;padding:12px;border-radius:10px;font-size:13px;line-height:1.5}.empty{color:#6a7890;text-align:center;padding:25px;border:1px dashed #c9d6e9;border-radius:12px}.search{max-width:340px}@media(max-width:650px){header{flex-wrap:wrap}.search{max-width:none}}
</style></head><body>
<header><div class="brand">▶ Lucky-S</div><input class="search" id="search" placeholder="चैनल या पोस्ट खोजें..." oninput="render()" style="margin:0"><button onclick="document.getElementById('create').scrollIntoView({behavior:'smooth'})">＋ चैनल बनाएँ</button></header>
<main>
<section class="hero"><h1>अपना चैनल बनाइए.<br><span style="color:#155eef">अपनी दुनिया शेयर कीजिए.</span></h1><p class="muted">अपने नाम से चैनल बनाएँ और उस पर वीडियो या फोटो पोस्ट करें।</p><button onclick="document.getElementById('create').scrollIntoView({behavior:'smooth'})">＋ नया चैनल बनाएँ</button> <button onclick="document.getElementById('upload').scrollIntoView({behavior:'smooth'})">वीडियो / फोटो अपलोड</button></section>
<section class="box" id="create"><h2>🎬 चैनल बनाएँ</h2><p class="muted">चैनल का नाम और जानकारी भरें।</p><form id="channelForm">
<label>चैनल का नाम *</label><input id="name" required maxlength="50" placeholder="जैसे: Rahul Gaming">
<label>कैटेगरी</label><select id="category"><option>मनोरंजन</option><option>गेमिंग</option><option>संगीत</option><option>शिक्षा</option><option>खेल</option><option>व्लॉग</option><option>टेक्नोलॉजी</option><option>अन्य</option></select>
<label>आपका नाम</label><input id="owner" maxlength="50" placeholder="अपना नाम">
<label>चैनल के बारे में</label><textarea id="desc" maxlength="300" placeholder="आपके चैनल पर क्या मिलेगा?"></textarea>
<button type="submit">चैनल बनाएँ</button></form></section>
<section class="box"><h2>🌟 चैनल एक्सप्लोर करें</h2><div id="channels" class="grid" style="margin-top:14px"></div></section>
<section class="box" id="upload"><h2>📤 चैनल पर वीडियो / फोटो पोस्ट करें</h2><p class="muted">पहले चैनल बनाएँ, फिर यहाँ से मीडिया चुनें।</p><form id="postForm"><label>चैनल चुनें *</label><select id="which" required></select><label>फोटो या वीडियो *</label><input id="file" type="file" accept="image/*,video/*" required><label>पोस्ट का शीर्षक</label><input id="caption" maxlength="100" placeholder="शीर्षक लिखें"><button type="submit">पोस्ट पब्लिश करें</button></form>
<div class="notice">महत्वपूर्ण: यह शुरुआती डेमो है। चैनल और मीडिया सिर्फ इसी ब्राउज़र में दिखेंगे। सभी यूज़र्स के चैनल/अपलोड ऑनलाइन दिखाने के लिए सुरक्षित अकाउंट सिस्टम, डेटाबेस और क्लाउड स्टोरेज जोड़ना होगा। डेमो में 3 MB से छोटी फाइलें ही अपलोड करें।</div></section>
<section class="box"><h2>🆕 नई पोस्ट</h2><div id="posts" class="grid" style="margin-top:14px"></div></section>
</main><script>
const CK='luckys_channel_list',PK='luckys_channel_posts';let channels=[],posts=[];
function load(){try{channels=JSON.parse(localStorage.getItem(CK)||'[]');posts=JSON.parse(localStorage.getItem(PK)||'[]')}catch(e){channels=[];posts=[]}}
function save(){try{localStorage.setItem(CK,JSON.stringify(channels));localStorage.setItem(PK,JSON.stringify(posts))}catch(e){alert('ब्राउज़र स्टोरेज भर गया है। कृपया छोटी फाइल चुनें।')}}
function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
document.getElementById('channelForm').onsubmit=e=>{e.preventDefault();let name=document.getElementById('name').value.trim();if(channels.some(c=>c.name.toLowerCase()===name.toLowerCase()))return alert('इस नाम का चैनल पहले से है।');channels.unshift({id:Date.now().toString(),name,category:document.getElementById('category').value,owner:document.getElementById('owner').value.trim()||'Creator',desc:document.getElementById('desc').value.trim()});save();e.target.reset();render();alert('आपका चैनल बन गया! अब उस पर फोटो या वीडियो पोस्ट करें।')};
document.getElementById('postForm').onsubmit=e=>{e.preventDefault();let ch=document.getElementById('which').value,f=document.getElementById('file').files[0];if(!ch||!f)return alert('चैनल और फाइल चुनें।');if(f.size>3*1024*1024)return alert('डेमो में फाइल 3 MB से छोटी रखें।');let r=new FileReader();r.onload=()=>{posts.unshift({id:Date.now().toString(),ch,file:f.name,type:f.type.startsWith('video/')?'video':'image',src:r.result,caption:document.getElementById('caption').value.trim()});save();e.target.reset();render();alert('पोस्ट पब्लिश हो गई!')};r.readAsDataURL(f)};
function render(){let q=document.getElementById('search').value.toLowerCase(),cs=document.getElementById('channels'),sel=document.getElementById('which');cs.innerHTML='';let found=channels.filter(c=>(c.name+c.category+c.owner+c.desc).toLowerCase().includes(q));if(!found.length)cs.innerHTML='<div class="empty">अभी चैनल नहीं है। ऊपर “चैनल बनाएँ” दबाएँ।</div>';found.forEach(c=>{let d=document.createElement('div');d.className='channel';d.innerHTML='<div class="avatar">▶</div><div><b>'+esc(c.name)+'</b><div class="muted">'+esc(c.category)+' • '+esc(c.owner)+'</div><p>'+esc(c.desc)+'</p></div>';cs.append(d)});let old=sel.value;sel.innerHTML=channels.length?'':'<option value="">पहले चैनल बनाएँ</option>';channels.forEach(c=>{let o=document.createElement('option');o.value=c.id;o.textContent=c.name;sel.append(o)});if(channels.some(c=>c.id===old))sel.value=old;let ps=document.getElementById('posts');ps.innerHTML='';let fp=posts.filter(p=>{let c=channels.find(c=>c.id===p.ch);return ((p.caption||'')+p.file+(c?c.name:'')).toLowerCase().includes(q)});if(!fp.length)ps.innerHTML='<div class="empty">अभी कोई पोस्ट नहीं। चैनल बनाकर पहली पोस्ट डालें।</div>';fp.forEach(p=>{let c=channels.find(c=>c.id===p.ch)||{name:'Channel'};let card=document.createElement('div');card.className='post';let m=document.createElement(p.type==='video'?'video':'img');m.src=p.src;if(p.type==='video')m.controls=true;else m.alt=p.caption||p.file;let t=document.createElement('p');t.textContent=p.caption||p.file;let s=document.createElement('small');s.textContent=c.name;card.append(m,t,s);ps.append(card)})}
load();render();
</script></body></html>
